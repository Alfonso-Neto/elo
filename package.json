{
  "name": "elo-web-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/check-styles.mjs && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "check:docs": "node scripts/check-docs.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:sql": "node scripts/check-sql-security.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "e2e": "playwright test e2e/public.spec.ts",
    "e2e:remote": "playwright test e2e/remote-ui.spec.ts",
    "e2e:isolation": "node scripts/remote-acceptance.mjs",
    "verify": "npm run check:docs && npm run check:source && npm run check:sql && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "^0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^25.0.1",
    "supabase": "^2.113.0",
    "typescript": "~5.9.2",
    "vite": "^8.2.1",
    "vitest": "^3.2.4"
  }
}
